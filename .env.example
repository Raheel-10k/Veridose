RELAYER_PRIVATE_KEY=

# Paste UIDs printed by: npx tsx scripts/register-schemas.ts
# Also visible on https://base-sepolia.easscan.org after registration
ATP_SCHEMA_UID=
BATCH_SCHEMA_UID=
CUSTODY_SCHEMA_UID=

# Optional: absolute origin for simulated NFC tap URLs in production
# NEXT_PUBLIC_APP_URL=http://localhost:3000
