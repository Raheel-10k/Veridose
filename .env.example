# Public Base Sepolia JSON-RPC (https://docs.base.org/docs/network-information)
# Optional paid RPC: Alchemy / QuickNode Base Sepolia dashboard URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Throwaway testnet wallet private key (0x...). Fund via Base Sepolia faucet:
# https://portal.cdp.coinbase.com/products/faucet
